{
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/api/blog-index"
    },
    {
      "source": "/blog/",
      "destination": "/api/blog-index"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ig-sync",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/backfill-videos",
      "schedule": "30 */4 * * *"
    },
    {
      "path": "/api/cron/ig-token-refresh",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/daily-agent",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/inbound-nudge",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/ads-scoreboard",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/dm-digest",
      "schedule": "30 3 * * 1,4"
    },
    {
      "path": "/api/cron/generate-blog",
      "schedule": "0 3 * * 1,4"
    },
    {
      "path": "/api/cron/blog-audit",
      "schedule": "0 6 * * 2"
    }
  ]
}
